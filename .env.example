# Secret Santa - Environment Variables
# Exemplo para deploy na Vercel e desenvolvimento local

NODE_ENV=development
APP_URL=http://localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
# Chave privada (NUNCA usar prefixo NEXT_PUBLIC_). Necessária para disparo de e-mails mantendo RLS estrita.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# Gmail SMTP via Nodemailer (Conta Google -> Segurança -> Senhas de app)
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD=sua-senha-de-app-16-digitos
EMAIL_FROM_NAME="Secret Santa"
